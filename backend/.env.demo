# =============================================================
# DEMO MODE — no real credentials required
# =============================================================
# How to activate:
#   Set DEMO_MODE=true in your OS/platform environment BEFORE starting Node.
#   On Railway/Render/Fly.io: add DEMO_MODE=true in the env-vars dashboard.
#   Locally: DEMO_MODE=true npm run start:dev
#
# How to go LIVE:
#   Remove DEMO_MODE (or set it to false) and switch to .env with real credentials.
# =============================================================

DEMO_MODE=true
NODE_ENV=development
PORT=3001

# The public URL of this backend (update after deploying)
APP_URL=https://your-demo-backend.up.railway.app
FRONTEND_URL=https://your-demo-frontend.vercel.app

# JWT — fixed demo secret (safe for demo only, never reuse in production)
JWT_SECRET=demo-only-secret-key-32chars-xYz9!NotForProd
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Database: uses SQLite in-memory when DEMO_MODE=true (no config needed)

# Redis/Bull: skipped when DEMO_MODE=true (no config needed)

# AWS S3: mocked in demo (no real uploads)
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=demo-bucket

# SendGrid: mocked in demo (emails logged to console only)
SENDGRID_FROM_EMAIL=noreply@settlement-os.com.au
SENDGRID_FROM_NAME=Settlement OS Demo

# PEXA / DocuSign: already mocked in MVP
PEXA_MOCK_MODE=true
DOCUSIGN_MOCK_MODE=true

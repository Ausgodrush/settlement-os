# Application
NODE_ENV=development
PORT=3001
APP_URL=https://api.settlementos.com.au
FRONTEND_URL=https://www.settlementos.com.au

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=settlement_os
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS S3
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=settlement-os-documents
S3_PRESIGNED_URL_EXPIRES=3600

# SendGrid
SENDGRID_API_KEY=SG.your_api_key
SENDGRID_FROM_EMAIL=noreply@settlement-os.com.au
SENDGRID_FROM_NAME=Settlement OS

# Twilio
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+61XXXXXXXXX

# PEXA (mock)
PEXA_API_URL=https://api.pexa.com.au/api/2
PEXA_API_KEY=mock_key
PEXA_MOCK_MODE=true

# DocuSign (mock)
DOCUSIGN_ACCOUNT_ID=mock_account_id
DOCUSIGN_INTEGRATION_KEY=mock_integration_key
DOCUSIGN_MOCK_MODE=true

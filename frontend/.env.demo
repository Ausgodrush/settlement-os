# =============================================================
# FRONTEND — DEMO MODE
# =============================================================
# How to use:
#   Copy this file to .env.local before building/running in demo mode.
#   Update the URLs below to match wherever you deployed the backend.
#
# How to go LIVE:
#   Copy .env.example to .env.local and fill in real URLs.
#   Remove NEXT_PUBLIC_DEMO_MODE (or set to false).
# =============================================================

NEXT_PUBLIC_DEMO_MODE=true

# Point at your deployed demo backend (update after deploying)
NEXT_PUBLIC_API_URL=https://your-demo-backend.up.railway.app/v1
NEXT_PUBLIC_WS_URL=https://your-demo-backend.up.railway.app
